# Geheimer Schlüssel für die Login-Sitzung (beliebige lange Zeichenkette)
AUTH_SECRET=bitte-durch-einen-langen-zufaelligen-wert-ersetzen

# Datenbank. Lokal: SQLite-Datei. In Produktion z. B. Turso: libsql://... plus Token.
DATABASE_URL=file:./data/stichtag.db
DATABASE_AUTH_TOKEN=

# Die beiden Konten, die beim Seed angelegt werden
PARTNER_1_NAME=Tom
PARTNER_1_EMAIL=tom@example.com
PARTNER_1_PASSWORD=stichtag
PARTNER_2_NAME=Partnerin
PARTNER_2_EMAIL=partnerin@example.com
PARTNER_2_PASSWORD=stichtag
